DATABASE_URL="postgresql://arbeitskleidung:arbeitskleidung@localhost:5432/arbeitskleidung?schema=public"
SESSION_SECRET="change-me-to-a-long-random-string"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Shared secret for the automation-only endpoints in routes/internal.ts
# (POST /internal/run-annual-grant, POST /internal/seed) — set this to a
# long random string in production, never leave it unset.
CRON_SECRET="change-me-to-a-long-random-string"

# Bootstrap admin account created by the /internal/seed run. CHANGE THESE
# before seeding a real deployment — the fallback values below are a
# well-known default and must not be left active in production.
SEED_ADMIN_EMAIL="admin@muellex.com"
SEED_ADMIN_PASSWORD="changeme123"

# Order-approval receipt email (optional — if unset, the receipt PDF is
# generated but not sent, and a warning is logged instead).
RESEND_API_KEY=""
RECEIPT_FROM_EMAIL="Müllex Webshop <onboarding@resend.dev>"
RECEIPT_TO_EMAIL="petra.wagner@jerichtrans.com"
