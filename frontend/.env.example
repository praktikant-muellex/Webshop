# Local dev only — the Vite dev server and backend run as two separate
# processes on localhost, so this must be the backend's real address.
#
# In Netlify (production), set this to "/api" instead, NOT the Render URL
# directly — netlify.toml proxies /api/* to the Render backend so the
# browser sees everything as one origin. Talking to Render directly from
# the browser makes the session cookie cross-site, which Safari's
# cross-site tracking prevention silently drops even with
# SameSite=None; Secure set (login "succeeds" but the session never
# sticks) — see the comment in netlify.toml for the full story.
VITE_API_URL=http://localhost:4000
